# Copy this file to .env and fill in real values.
# Never commit .env.

# --- App ---
APP_NAME=AetherCode
ENV=development

# --- Supabase (Settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (set at least one) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# --- Safety ---
MAX_DEBUG_ATTEMPTS=3

# --- Production CORS (comma-separated frontend URLs) ---
CORS_ORIGINS=
